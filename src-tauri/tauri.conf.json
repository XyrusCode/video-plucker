{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xyrus YT Plucker",
  "mainBinaryName": "yt-plucker",
  "version": "3.4.0",
  "identifier": "tech.acachi.ytplucker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xyrus' YT Plucker",
        "width": 920,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yt-plucker"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
