# Rust / Tauri build output
/src-tauri/target/
/src-tauri/gen/
/src-tauri/build.log

# pinned sidecar binaries — see README for download commands
/src-tauri/binaries/*.exe

# Local GNU-toolchain build config + helper scripts (machine-specific;
# CI and MSVC machines build with defaults)
/src-tauri/.cargo/
/dev.ps1
/build.ps1

.wrangler/

# Test-only frontend harness (see package.json). The shipped app has no npm
# dependency; this exists so CI can run the Playwright smoke test.
/node_modules/
/test-results/
/playwright-report/
/screenshots/

# Incremental graphify output; regenerate with `graphify update .`
/graphify-out/
